# ── LLM
# OpenAI (usado si OPENROUTER_API_KEY está vacío)
OPENAI_API_KEY=sk-...
# OpenRouter — si se define, tiene prioridad sobre OPENAI_API_KEY
# Obtén tu clave en https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Ejemplo con OpenRouter: google/gemma-4-26b-a4b-it
AI_MODEL=gpt-4o-mini
MAX_INPUT_CHARS=360
MAX_OUTPUT_TOKENS=800

# ── Base de datos 
# Formato: postgresql://usuario:contraseña@host:puerto/nombre_db
DATABASE_URL=postgresql://nexo:nexo_dev@localhost:5432/nexo_db

# ── Redis ────────────────────────────────────────────────────────────────────
# Formato: redis://host:port/db_number
REDIS_URL=redis://localhost:6379/0
# TTL en segundos para la caché del menú (0 = sin límite)
CACHE_MENU_TTL=300
# TTL en segundos para respuestas FAQ cacheadas
CACHE_FAQ_TTL=3600

# ── Twilio (WhatsApp) ────────────────────────────────────────────────────────
# Obtén estas credenciales en https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Formato: +14155238886 (número del sandbox) o tu número aprobado
TWILIO_WHATSAPP_NUMBER=+14155238886

# ── Wompi (Pagos) ────────────────────────────────────────────────────────────
# Obtén estas claves en https://comercios.wompi.co
WOMPI_PUBLIC_KEY=pub_stagtest_...
WOMPI_PRIVATE_KEY=prv_stagtest_...
# Secreto de eventos para validar webhooks de Wompi
WOMPI_EVENTS_SECRET=stagtest_events_...

# ── Langfuse (Observabilidad LLM) ───────────────────────────────────────────
# Deja vacío para deshabilitar tracing. Obtén claves en https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Para self-hosted: http://localhost:3000
LANGFUSE_HOST=https://cloud.langfuse.com

# ── Aplicación ───────────────────────────────────────────────────────────────
# Nombre que aparecerá en recibos y mensajes enviados a los clientes
RESTAURANTE_NOMBRE=Tu Restaurante
# URL pública del servidor (usada por ngrok en desarrollo)
# Ejemplo: https://abc123.ngrok-free.app
BASE_URL=http://localhost:8000
DEBUG=false
# Nivel de log: DEBUG | INFO | WARNING | ERROR (usar WARNING para reducir ruido en producción)
LOG_LEVEL=INFO

# ── JWT / Panel admin ────────────────────────────────────────────────────────
# Clave secreta para firmar tokens JWT. Cámbiala en producción.
SECRET_KEY=nexo-dev-secret-key-change-in-production
# Duración del token en minutos (480 = 8 horas)
JWT_EXPIRE_MINUTES=480
# Credenciales del operador admin inicial. Si ADMIN_PASSWORD está vacío no se crea.
ADMIN_EMAIL=admin@nexo.app
ADMIN_PASSWORD=
# Restaurante (tenant) al que se asigna el operador admin inicial.
ADMIN_RESTAURANTE_ID=default